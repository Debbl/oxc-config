{
  "categories": {
    "correctness": "deny",
    "suspicious": "warn",
  },
  "options": {
    "typeAware": true,
  },
  "overrides": [
    {
      "env": null,
      "files": [
        "scripts/**/*",
        "**/cli.*",
      ],
      "globals": null,
      "plugins": null,
      "rules": {
        "no-console": "allow",
      },
    },
    {
      "env": null,
      "files": [
        "**/*.d.ts",
      ],
      "globals": null,
      "plugins": null,
      "rules": {
        "import/no-duplicates": "allow",
        "no-unused-vars": "allow",
      },
    },
    {
      "env": null,
      "files": [
        "**/__tests__/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
        "**/*.{spec,test,bench,benchmark}.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
      ],
      "globals": null,
      "plugins": null,
      "rules": {
        "no-unused-expressions": "allow",
        "vitest/consistent-test-it": [
          "deny",
          [
            {
              "fn": "it",
              "withinDescribe": "it",
            },
          ],
        ],
        "vitest/no-focused-tests": "deny",
        "vitest/no-identical-title": "deny",
        "vitest/no-import-node-test": "deny",
        "vitest/prefer-hooks-in-order": "deny",
        "vitest/prefer-lowercase-title": "deny",
      },
    },
  ],
  "plugins": [
    "import",
    "jsdoc",
    "node",
    "oxc",
    "typescript",
    "unicorn",
    "vitest",
  ],
  "rules": {
    "accessor-pairs": [
      "deny",
      [
        {
          "enforceForClassMembers": true,
          "setWithoutGet": true,
        },
      ],
    ],
    "array-callback-return": "deny",
    "block-scoped-var": "deny",
    "constructor-super": "deny",
    "default-case-last": "deny",
    "eqeqeq": [
      "deny",
      [
        "smart",
      ],
    ],
    "for-direction": "deny",
    "getter-return": "deny",
    "import/consistent-type-specifier-style": [
      "deny",
      [
        "prefer-top-level",
      ],
    ],
    "import/default": "deny",
    "import/first": "deny",
    "import/namespace": "deny",
    "import/newline-after-import": [
      "deny",
      [
        {
          "count": 1,
        },
      ],
    ],
    "import/no-absolute-path": "warn",
    "import/no-duplicates": "deny",
    "import/no-empty-named-blocks": "warn",
    "import/no-mutable-exports": "deny",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-named-default": "deny",
    "import/no-self-import": "deny",
    "import/no-unassigned-import": "allow",
    "import/no-webpack-loader-syntax": "deny",
    "jsdoc/check-access": "warn",
    "jsdoc/check-property-names": "deny",
    "jsdoc/check-tag-names": "deny",
    "jsdoc/empty-tags": "warn",
    "jsdoc/implements-on-classes": "deny",
    "jsdoc/no-defaults": "deny",
    "jsdoc/require-param-name": "warn",
    "jsdoc/require-property": "deny",
    "jsdoc/require-property-description": "deny",
    "jsdoc/require-property-name": "deny",
    "jsdoc/require-property-type": "deny",
    "jsdoc/require-returns-description": "warn",
    "jsdoc/require-yields": "deny",
    "new-cap": [
      "deny",
      [
        {
          "capIsNew": false,
          "newIsCap": true,
          "properties": true,
        },
      ],
    ],
    "no-alert": "deny",
    "no-array-constructor": "deny",
    "no-async-promise-executor": "deny",
    "no-caller": "deny",
    "no-case-declarations": "deny",
    "no-class-assign": "deny",
    "no-compare-neg-zero": "deny",
    "no-cond-assign": "deny",
    "no-console": [
      "deny",
      [
        {
          "allow": [
            "warn",
            "error",
          ],
        },
      ],
    ],
    "no-const-assign": "deny",
    "no-constant-binary-expression": "deny",
    "no-constant-condition": "deny",
    "no-control-regex": "deny",
    "no-debugger": "deny",
    "no-delete-var": "deny",
    "no-dupe-class-members": "deny",
    "no-dupe-else-if": "deny",
    "no-dupe-keys": "deny",
    "no-duplicate-case": "deny",
    "no-empty": [
      "deny",
      [
        {
          "allowEmptyCatch": true,
        },
      ],
    ],
    "no-empty-character-class": "deny",
    "no-empty-pattern": "deny",
    "no-empty-static-block": "deny",
    "no-eval": "deny",
    "no-ex-assign": "deny",
    "no-extend-native": "deny",
    "no-extra-bind": "deny",
    "no-extra-boolean-cast": "deny",
    "no-fallthrough": "deny",
    "no-func-assign": "deny",
    "no-global-assign": "deny",
    "no-implied-eval": "deny",
    "no-import-assign": "deny",
    "no-invalid-regexp": "deny",
    "no-irregular-whitespace": "deny",
    "no-iterator": "deny",
    "no-labels": [
      "deny",
      [
        {
          "allowLoop": false,
          "allowSwitch": false,
        },
      ],
    ],
    "no-lone-blocks": "deny",
    "no-loss-of-precision": "deny",
    "no-misleading-character-class": "deny",
    "no-multi-str": "deny",
    "no-new": "deny",
    "no-new-func": "deny",
    "no-new-native-nonconstructor": "deny",
    "no-new-wrappers": "deny",
    "no-nonoctal-decimal-escape": "deny",
    "no-obj-calls": "deny",
    "no-proto": "deny",
    "no-prototype-builtins": "deny",
    "no-redeclare": [
      "deny",
      [
        {
          "builtinGlobals": false,
        },
      ],
    ],
    "no-regex-spaces": "deny",
    "no-restricted-globals": [
      "deny",
      [
        {
          "message": "Use `globalThis` instead.",
          "name": "global",
        },
        {
          "message": "Use `globalThis` instead.",
          "name": "self",
        },
      ],
    ],
    "no-restricted-properties": [
      "deny",
      [
        {
          "message": "Use `Object.getPrototypeOf` or `Object.setPrototypeOf` instead.",
          "property": "__proto__",
        },
        {
          "message": "Use `Object.defineProperty` instead.",
          "property": "__defineGetter__",
        },
        {
          "message": "Use `Object.defineProperty` instead.",
          "property": "__defineSetter__",
        },
        {
          "message": "Use `Object.getOwnPropertyDescriptor` instead.",
          "property": "__lookupGetter__",
        },
        {
          "message": "Use `Object.getOwnPropertyDescriptor` instead.",
          "property": "__lookupSetter__",
        },
      ],
    ],
    "no-self-assign": "deny",
    "no-self-compare": "deny",
    "no-sequences": "deny",
    "no-setter-return": "deny",
    "no-shadow": "allow",
    "no-shadow-restricted-names": "deny",
    "no-sparse-arrays": "deny",
    "no-template-curly-in-string": "deny",
    "no-this-before-super": "deny",
    "no-throw-literal": "deny",
    "no-unassigned-vars": "deny",
    "no-underscore-dangle": "allow",
    "no-unexpected-multiline": "warn",
    "no-unmodified-loop-condition": "deny",
    "no-unneeded-ternary": "deny",
    "no-unreachable": "deny",
    "no-unreachable-loop": "deny",
    "no-unsafe-finally": "deny",
    "no-unsafe-negation": "deny",
    "no-unsafe-optional-chaining": "deny",
    "no-unused-expressions": "deny",
    "no-unused-labels": "deny",
    "no-unused-private-class-members": "deny",
    "no-unused-vars": [
      "deny",
      [
        {
          "args": "after-used",
          "argsIgnorePattern": "^_",
          "vars": "all",
          "varsIgnorePattern": "^_",
        },
      ],
    ],
    "no-use-before-define": [
      "deny",
      [
        {
          "classes": false,
          "functions": false,
          "variables": true,
        },
      ],
    ],
    "no-useless-backreference": "deny",
    "no-useless-call": "deny",
    "no-useless-catch": "deny",
    "no-useless-computed-key": "deny",
    "no-useless-concat": "warn",
    "no-useless-constructor": "warn",
    "no-useless-escape": "deny",
    "no-useless-rename": "deny",
    "no-useless-return": "deny",
    "no-var": "deny",
    "no-with": "deny",
    "node/handle-callback-err": [
      "deny",
      [
        "^(err|error)$",
      ],
    ],
    "node/no-exports-assign": "deny",
    "node/no-new-require": "deny",
    "node/no-path-concat": "deny",
    "object-shorthand": [
      "deny",
      [
        "always",
        {
          "avoidQuotes": true,
          "ignoreConstructors": false,
        },
      ],
    ],
    "one-var": [
      "deny",
      [
        {
          "initialized": "never",
        },
      ],
    ],
    "oxc/approx-constant": "warn",
    "oxc/bad-array-method-on-arguments": "deny",
    "oxc/bad-char-at-comparison": "deny",
    "oxc/bad-comparison-sequence": "deny",
    "oxc/bad-match-all-arg": "deny",
    "oxc/bad-min-max-func": "deny",
    "oxc/bad-object-literal-comparison": "deny",
    "oxc/bad-replace-all-arg": "deny",
    "oxc/const-comparisons": "deny",
    "oxc/double-comparisons": "deny",
    "oxc/erasing-op": "deny",
    "oxc/misrefactored-assign-op": "warn",
    "oxc/missing-throw": "deny",
    "oxc/no-async-endpoint-handlers": "warn",
    "oxc/no-this-in-exported-function": "warn",
    "oxc/number-arg-out-of-range": "deny",
    "oxc/only-used-in-recursion": "deny",
    "oxc/uninvoked-array-callback": "deny",
    "prefer-const": [
      "deny",
      [
        {
          "destructuring": "all",
          "ignoreReadBeforeAssign": true,
        },
      ],
    ],
    "prefer-exponentiation-operator": "deny",
    "prefer-promise-reject-errors": "deny",
    "prefer-regex-literals": [
      "deny",
      [
        {
          "disallowRedundantWrapping": true,
        },
      ],
    ],
    "prefer-rest-params": "deny",
    "prefer-spread": "deny",
    "prefer-template": "deny",
    "preserve-caught-error": "warn",
    "require-yield": "deny",
    "symbol-description": "deny",
    "typescript/await-thenable": "deny",
    "typescript/ban-ts-comment": [
      "deny",
      [
        {
          "ts-expect-error": "allow-with-description",
        },
      ],
    ],
    "typescript/consistent-return": "warn",
    "typescript/consistent-type-definitions": [
      "deny",
      [
        "interface",
      ],
    ],
    "typescript/consistent-type-imports": [
      "deny",
      [
        {
          "disallowTypeAnnotations": false,
          "fixStyle": "separate-type-imports",
          "prefer": "type-imports",
        },
      ],
    ],
    "typescript/method-signature-style": [
      "deny",
      [
        "property",
      ],
    ],
    "typescript/no-array-delete": "deny",
    "typescript/no-base-to-string": "deny",
    "typescript/no-confusing-non-null-assertion": "warn",
    "typescript/no-duplicate-enum-values": "deny",
    "typescript/no-duplicate-type-constituents": "deny",
    "typescript/no-empty-object-type": [
      "deny",
      [
        {
          "allowInterfaces": "always",
        },
      ],
    ],
    "typescript/no-extra-non-null-assertion": "deny",
    "typescript/no-extraneous-class": "warn",
    "typescript/no-floating-promises": "deny",
    "typescript/no-for-in-array": "deny",
    "typescript/no-implied-eval": "deny",
    "typescript/no-import-type-side-effects": "deny",
    "typescript/no-meaningless-void-operator": "deny",
    "typescript/no-misused-new": "deny",
    "typescript/no-misused-promises": "deny",
    "typescript/no-misused-spread": "deny",
    "typescript/no-namespace": "deny",
    "typescript/no-non-null-asserted-nullish-coalescing": "deny",
    "typescript/no-non-null-asserted-optional-chain": "deny",
    "typescript/no-redundant-type-constituents": "deny",
    "typescript/no-require-imports": "deny",
    "typescript/no-this-alias": "deny",
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    "typescript/no-unnecessary-parameter-property-assignment": "deny",
    "typescript/no-unnecessary-template-expression": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-assertion": "deny",
    "typescript/no-unnecessary-type-constraint": "deny",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "typescript/no-unsafe-argument": "deny",
    "typescript/no-unsafe-assignment": "deny",
    "typescript/no-unsafe-call": "deny",
    "typescript/no-unsafe-declaration-merging": "deny",
    "typescript/no-unsafe-enum-comparison": "warn",
    "typescript/no-unsafe-function-type": "deny",
    "typescript/no-unsafe-member-access": "deny",
    "typescript/no-unsafe-return": "deny",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/no-unsafe-unary-minus": "deny",
    "typescript/no-useless-default-assignment": "deny",
    "typescript/no-useless-empty-export": "deny",
    "typescript/no-wrapper-object-types": "deny",
    "typescript/prefer-as-const": "deny",
    "typescript/prefer-literal-enum-member": "deny",
    "typescript/prefer-namespace-keyword": "deny",
    "typescript/promise-function-async": "deny",
    "typescript/require-array-sort-compare": "deny",
    "typescript/restrict-plus-operands": "deny",
    "typescript/restrict-template-expressions": "deny",
    "typescript/return-await": [
      "deny",
      [
        "in-try-catch",
      ],
    ],
    "typescript/strict-boolean-expressions": [
      "deny",
      [
        {
          "allowNullableBoolean": true,
          "allowNullableObject": true,
        },
      ],
    ],
    "typescript/switch-exhaustiveness-check": "deny",
    "typescript/triple-slash-reference": "deny",
    "typescript/unbound-method": "deny",
    "unicode-bom": [
      "deny",
      [
        "never",
      ],
    ],
    "unicorn/consistent-empty-array-spread": "deny",
    "unicorn/consistent-function-scoping": [
      "deny",
      [
        {
          "checkArrowFunctions": false,
        },
      ],
    ],
    "unicorn/error-message": "deny",
    "unicorn/escape-case": "deny",
    "unicorn/new-for-builtins": "deny",
    "unicorn/no-accessor-recursion": "warn",
    "unicorn/no-array-fill-with-reference-type": "warn",
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/no-await-in-promise-methods": "deny",
    "unicorn/no-confusing-array-with": "warn",
    "unicorn/no-empty-file": "deny",
    "unicorn/no-instanceof-builtins": "deny",
    "unicorn/no-invalid-fetch-options": "deny",
    "unicorn/no-invalid-remove-event-listener": "deny",
    "unicorn/no-new-array": "deny",
    "unicorn/no-new-buffer": "deny",
    "unicorn/no-single-promise-in-promise-methods": "deny",
    "unicorn/no-thenable": "deny",
    "unicorn/no-unnecessary-await": "deny",
    "unicorn/no-useless-fallback-in-spread": "deny",
    "unicorn/no-useless-length-check": "deny",
    "unicorn/no-useless-spread": "deny",
    "unicorn/prefer-add-event-listener": "warn",
    "unicorn/prefer-dom-node-text-content": "deny",
    "unicorn/prefer-includes": "deny",
    "unicorn/prefer-node-protocol": "deny",
    "unicorn/prefer-number-properties": "deny",
    "unicorn/prefer-set-size": "deny",
    "unicorn/prefer-string-starts-ends-with": "deny",
    "unicorn/prefer-type-error": "deny",
    "unicorn/require-module-specifiers": "warn",
    "unicorn/require-post-message-target-origin": "warn",
    "unicorn/throw-new-error": "deny",
    "use-isnan": "deny",
    "valid-typeof": "deny",
    "vars-on-top": "deny",
    "vitest/expect-expect": "deny",
    "vitest/hoisted-apis-on-top": "deny",
    "vitest/no-commented-out-tests": "warn",
    "vitest/no-conditional-expect": "deny",
    "vitest/no-conditional-tests": "deny",
    "vitest/no-disabled-tests": "deny",
    "vitest/no-focused-tests": "deny",
    "vitest/no-standalone-expect": "deny",
    "vitest/prefer-snapshot-hint": "deny",
    "vitest/require-awaited-expect-poll": "deny",
    "vitest/require-local-test-context-for-concurrent-snapshots": "deny",
    "vitest/require-mock-type-parameters": "deny",
    "vitest/require-to-throw-message": "deny",
    "vitest/valid-describe-callback": "deny",
    "vitest/valid-expect": "deny",
    "vitest/valid-expect-in-promise": "deny",
    "vitest/valid-title": "deny",
    "vitest/warn-todo": "deny",
    "yoda": [
      "deny",
      [
        "never",
      ],
    ],
  },
}